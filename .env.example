# KalaSetu AI — Environment Variables
PORT=4000

# =========================================================
# SUPABASE DATABASE
# =========================================================
# 1) Create a free Supabase project.
# 2) Run supabase/schema.sql in Supabase SQL Editor.
# 3) Copy Project URL + service_role key from:
#    Project Settings → API
# 4) Create a local .env file (do NOT upload .env to GitHub).

USE_SUPABASE=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# IMPORTANT:
# The service-role key belongs ONLY on the Node.js backend.
# Never place it inside public/app.js or any browser code.

# =========================================================
# EXISTING AI SERVICES (optional / use your team's keys)
# =========================================================
# GEMINI_API_KEY=
# ASSEMBLYAI_API_KEY=
# REMOVE_BG_API_KEY=


# =========================================================
# COHERE SMART RECOMMENDATIONS
# =========================================================
# Keep this key ONLY in your local .env file.
# Never paste it into public/app.js and never commit .env to GitHub.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-fast
